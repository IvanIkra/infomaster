# Copy to .env and fill in. Real environment variables win over this file.

# Telegram app for the twin and the bot (my.telegram.org)
TG_API_ID=
TG_API_HASH=
# Bot from @BotFather; an admin of the forum group with the "Manage topics" right
TG_BOT_TOKEN=
# Your Telegram id: the only one the bot and the Mini App let in
TG_OWNER_ID=
# Forum group, marked id: -100...
TG_FORUM_ID=

ANTHROPIC_API_KEY=

# Bearer token of the internal API for Tablo
API_TOKEN=

# Optional. RUZ timetable in iCal, a secret link: https://api.hseapp.ru/v3/ruz/cal/<uuid>
# Without it the timetable has only events from chats
RUZ_ICAL_URL=
# Optional. Secret path segment of our iCal feeds on the internal port, at least 16 of A-Z a-z 0-9 _ -:
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Feeds: http://infomaster:8081/calendar/<secret>/main.ics, optional.ics, tablo.ics. Without it the feeds are off
CALENDAR_SECRET=

# University mailbox @edu.hse.ru (Yandex 360), an app password; without both the mail source is off
MAIL_USER=
MAIL_PASSWORD=
# MAIL_HOST=imap.yandex.ru
# MAIL_PORT=993

# Funnel address of the public port, no trailing slash: https://infomaster.<tailnet>.ts.net
# The Mini App lives under it, and the HSE App X login comes back to <PUBLIC_URL>/hseapp/callback
PUBLIC_URL=
# Auth key of the personal tailnet for the sidecar; needed only for its first start
TS_AUTHKEY=

# DNS servers of both containers (compose.yaml), e.g. the host's dnsmasq and the router, or 1.1.1.1 and 9.9.9.9
CONTAINER_DNS_1=
CONTAINER_DNS_2=

# Ports inside the container
# HTTP_PUBLIC_PORT=8080
# HTTP_INTERNAL_PORT=8081
