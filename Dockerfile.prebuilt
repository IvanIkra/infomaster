# The runtime image of Dockerfile from binaries compiled elsewhere (scripts/deploy.sh puts the context together:
# infomaster, compare, static/). Keep the two runtime stages the same.
FROM alpine:3.22
RUN apk add --no-cache tzdata ca-certificates
WORKDIR /app
COPY static web/static
COPY infomaster compare /usr/local/bin/
ENV WEB_STATIC=/app/web/static

ARG APP_UID=1000
RUN addgroup -g "$APP_UID" app && adduser -D -H -u "$APP_UID" -G app -h /app/data -s /sbin/nologin app
USER app

EXPOSE 8080 8081
CMD ["infomaster", "--data", "data"]
